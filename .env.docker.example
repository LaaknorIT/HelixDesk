# HelixDesk settings for `docker compose`. Copy to .env and fill in the values
# marked "required". Everything in .env.example can also be set here.

APP_NAME=HelixDesk
# Required: the URL people use to reach HelixDesk, including https:// when behind a proxy.
APP_URL=http://localhost:8080
# Required: generate with `echo "base64:$(openssl rand -base64 32)"`. Keep it secret and never change it.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_LEVEL=info

# Port on the host that serves HelixDesk.
HELIXDESK_HTTP_PORT=8080
# Image to run. Set to a release tag such as ghcr.io/laaknorit/helixdesk:v1.0.0 to pin a version.
HELIXDESK_IMAGE=ghcr.io/laaknorit/helixdesk:latest
# Set to false to run migrations by hand with `docker compose run --rm app php artisan migrate`.
HELIXDESK_MIGRATE=true

# PostgreSQL (created by compose on first start).
DB_DATABASE=helixdesk
DB_USERNAME=helixdesk
# Required: a long random password.
DB_PASSWORD=

# Set to the IP range of your reverse proxy, or * when only the proxy can reach the container.
TRUSTED_PROXIES=

# Outgoing system mail. Ticket mail uses the mailboxes configured in the agent panel.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=helixdesk@example.com
MAIL_FROM_NAME="${APP_NAME}"
